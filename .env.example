# ─── InboxBridge configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit .env.

# ─── App ────────────────────────────────────────────────────────────────────
# Kill switch: when false, sending emails is technically impossible.
# Development and tests MUST start with false.
SEND_EMAILS=false

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Telegram ───────────────────────────────────────────────────────────────
# Bot token from @BotFather. Keep it private.
TELEGRAM_BOT_TOKEN=

# Numeric chat id of the authorized private group (e.g. -1001234567890).
# Only this chat is processed; everything else is ignored.
TELEGRAM_ALLOWED_CHAT_ID=

# ─── LLM (OpenAI-compatible) ────────────────────────────────────────────────
# Example: OpenCode Go / DeepSeek direct / OpenRouter — any OpenAI-compatible
# endpoint. Do not enable automatic paid fallbacks between providers.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Max tokens for summaries / drafts (cost control)
LLM_MAX_TOKENS_SUMMARY=700
LLM_MAX_TOKENS_DRAFT=1000
LLM_TEMPERATURE=0.4

# ─── Gmail / Google ─────────────────────────────────────────────────────────
# OAuth 2.0 client credentials for YOUR installation (Google Cloud Console).
# Path to client_secret.json downloaded from your OAuth client.
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json
# Where the refresh token is stored after first auth (local file).
GOOGLE_TOKEN_FILE=credentials/token.json
# Account used for the "Primary inbox" watch. Leave empty to use the
# authenticated account's own email.
GMAIL_USER_ID=me

# Google Cloud project id hosting the Pub/Sub topic + subscription.
GOOGLE_CLOUD_PROJECT=

# Service account key used to consume the Pub/Sub subscription (StreamingPull).
# Create a dedicated service account with Pub/Sub Subscriber role on the
# subscription and download its JSON key here. When empty, InboxBridge falls
# back to Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account_pubsub.json

# Pub/Sub topic name (SHORT name, e.g. gmail-events — the full path
# projects/<proj>/topics/<name> is built by the code).
GMAIL_PUBSUB_TOPIC=gmail-events

# Pub/Sub subscription name (SHORT name, e.g. gmail-events-pull — the full
# path projects/<proj>/subscriptions/<name> is built by the code).
# StreamingPull is used; no public webhook needed.
GMAIL_PUBSUB_SUBSCRIPTION=gmail-events-pull

# ─── Attachment / parsing limits ────────────────────────────────────────────
# Password for password-protected PDFs (known secret, never committed).
PDF_PASSWORD=

# Max attachment size in bytes (default 10 MB)
ATTACHMENT_MAX_BYTES=10485760
# Max extracted text length per attachment (chars, default 20000)
ATTACHMENT_MAX_TEXT_CHARS=20000
# Max number of attachments processed per email
ATTACHMENT_MAX_COUNT=5

# ─── Retries / operations ───────────────────────────────────────────────────
# Max LLM retry attempts per email before marking failed
LLM_MAX_RETRIES=3
# Base backoff seconds for retries (exponential)
RETRY_BACKOFF_BASE=2
