# ─── InboxBridge configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit .env.

# ─── App ────────────────────────────────────────────────────────────────────
# Kill switch: when false, sending emails is technically impossible.
# Development and tests MUST start with false.
SEND_EMAILS=false

# Display/signature name used on outgoing drafts (appended after the formal
# closing, e.g. "Mit freundlichen Grüßen" + this name). Explicit trusted
# configuration — NEVER inferred from emails/LLM/Telegram content. When empty,
# a draft ending on a formal closing without a signature is rejected as
# incomplete (not sendable). Change this together with the OAuth token when
# switching Gmail accounts.
EMAIL_SIGNATURE_NAME=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Telegram ───────────────────────────────────────────────────────────────
# Bot token from @BotFather. Keep it private.
TELEGRAM_BOT_TOKEN=

# Numeric chat id of the authorized private group (e.g. -1001234567890).
# Only this chat is processed; everything else is ignored.
TELEGRAM_ALLOWED_CHAT_ID=

# ─── LLM (OpenAI-compatible) ────────────────────────────────────────────────
# Example: OpenCode Go / DeepSeek direct / OpenRouter — any OpenAI-compatible
# endpoint. Do not enable automatic paid fallbacks between providers.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# OPTIONAL second TEXT model on the SAME provider/gateway (same base URL and
# API key). Used ONLY as a bounded technical-reliability fallback: when the
# primary text model fails transiently (empty/incomplete output, rate limit,
# provider unavailable/timeout) or produces an unparseable structured contract
# (Q&A / thread summary JSON), the retry attempt runs on this model with the
# SAME logical input. NEVER a quality/judging switch.
# Empty → text fallback disabled (current behavior). Same as LLM_MODEL →
# treated as disabled. The owner chooses the model id; nothing is hardcoded.
AI_TEXT_FALLBACK_MODEL=

# ─── Task-aware output budgets ──────────────────────────────────────────────
# max_tokens is a CEILING, not guaranteed consumption. Reasoning-capable models
# consume part of max_tokens internally, so each task gets enough headroom to
# reach its visible output while staying bounded. Bump these only if a
# reasoning model still truncates a given task.
LLM_MAX_TOKENS_SUMMARY=1000          # incoming email summary JSON
LLM_MAX_TOKENS_DRAFT=1600            # reply / compose / forward / draft edit
LLM_MAX_TOKENS_INTENT=400            # intent classification (stays small)
LLM_MAX_TOKENS_QA=1600               # structured Q&A
LLM_MAX_TOKENS_THREAD_SUMMARY=2000   # structured thread summary
LLM_MAX_TOKENS_THREAD_SUMMARY_PLAIN=1500  # plain thread-summary fallback
LLM_MAX_TOKENS_TRANSLATION=1200      # DE→ES preview translation
LLM_TEMPERATURE=0.4

# ─── Gmail / Google ─────────────────────────────────────────────────────────
# OAuth 2.0 client credentials for YOUR installation (Google Cloud Console).
# Path to client_secret.json downloaded from your OAuth client.
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json
# Where the refresh token is stored after first auth. It MUST be on a writable
# path: access-token refreshes are saved back here. Use the persistent data
# volume (data/) — the credentials/ bind mount is read-only in Docker.
GOOGLE_TOKEN_FILE=data/token.json
# Account used for the "Primary inbox" watch. Leave empty to use the
# authenticated account's own email.
GMAIL_USER_ID=me

# Google Cloud project id hosting the Pub/Sub topic + subscription.
GOOGLE_CLOUD_PROJECT=

# Service account key used to consume the Pub/Sub subscription (StreamingPull).
# Create a dedicated service account with Pub/Sub Subscriber role on the
# subscription and download its JSON key here. When empty, InboxBridge falls
# back to Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account_pubsub.json

# Pub/Sub topic name (SHORT name, e.g. gmail-events — the full path
# projects/<proj>/topics/<name> is built by the code).
GMAIL_PUBSUB_TOPIC=gmail-events

# Pub/Sub subscription name (SHORT name, e.g. gmail-events-pull — the full
# path projects/<proj>/subscriptions/<name> is built by the code).
# StreamingPull is used; no public webhook needed.
GMAIL_PUBSUB_SUBSCRIPTION=gmail-events-pull

# ─── Attachment / parsing limits ────────────────────────────────────────────
# Password for password-protected PDFs (known secret, never committed).
PDF_PASSWORD=

# Max attachment size in bytes (default 10 MB)
ATTACHMENT_MAX_BYTES=10485760
# Max extracted text length per attachment (chars, default 20000)
ATTACHMENT_MAX_TEXT_CHARS=20000
# Max number of attachments processed per email
ATTACHMENT_MAX_COUNT=5

# ─── Retries / operations ───────────────────────────────────────────────────
# Max LLM retry attempts per email before marking failed
LLM_MAX_RETRIES=3
# Base backoff seconds for retries (exponential)
RETRY_BACKOFF_BASE=2
